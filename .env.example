# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used for auth redirect links (magic link, email confirmation, OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Show "Mit Google anmelden" (requires Google provider configured in Supabase)
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
